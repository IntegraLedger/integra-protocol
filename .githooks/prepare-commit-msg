#!/bin/sh
# Append the DCO sign-off CONTRIBUTING.md requires, so the flag cannot be forgotten.
#
# `git commit -s` is the documented way and it is one flag, but a flag is a habit and habits miss. The
# trailer "cannot be reconstructed after the fact" — a commit that lands without it is unfixable once
# pushed to public main, because the remedy would be rewriting published history. So the cost of
# forgetting is permanent, which is exactly the shape that earns automation.
#
# NOTE this is a convenience, not the enforcement. Hooks live in the clone, never in the tree that is
# pushed, so a fresh clone or another machine has none until `pnpm install` runs. `commit-policy.yml` is
# what actually holds the line.
#
# $2 is the message SOURCE. `merge` and `squash` messages are generated by git and are exempt from DCO
# everywhere; signing one would attest authorship of a machine-written message.
case "$2" in
  merge | squash) exit 0 ;;
esac

name=$(git config user.name)
email=$(git config user.email)
if [ -z "$name" ] || [ -z "$email" ]; then
  echo "prepare-commit-msg: user.name/user.email unset — cannot add the DCO sign-off." >&2
  echo "  git config user.name '…' && git config user.email '…'" >&2
  exit 1
fi

signoff="Signed-off-by: $name <$email>"
# Already present (the author passed -s, or is amending a signed commit) — never duplicate it.
grep -qsF "$signoff" "$1" && exit 0

# Appended at the very end ON PURPOSE. Git strips the '#' comment block when it cleans the message up,
# and a trailer written above that block would land mid-message instead of in the trailer section.
printf '\n%s\n' "$signoff" >> "$1"
