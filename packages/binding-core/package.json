{
  "name": "@integraledger/lcp-binding-core",
  "version": "0.15.1",
  "description": "The LCP carrier codec, and the port every rail binding implements.",
  "keywords": [
    "lcp",
    "legal-context-protocol",
    "legal-terms",
    "agentic-commerce",
    "carrier",
    "binding"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IntegraLedger/integra-protocol.git",
    "directory": "packages/binding-core"
  },
  "bugs": {
    "url": "https://github.com/IntegraLedger/integra-protocol/issues"
  },
  "homepage": "https://github.com/IntegraLedger/integra-protocol/tree/main/packages/binding-core#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/sync-license.mjs"
  },
  "dependencies": {
    "@integraledger/lcp-kernel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  }
}
