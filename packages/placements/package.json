{
  "name": "@integraledger/lcp-placements",
  "version": "0.12.3",
  "description": "The LCP placement registry — the one place a protocol is registered.",
  "keywords": [
    "lcp",
    "legal-context-protocol",
    "legal-terms",
    "agentic-commerce",
    "placement",
    "registry"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IntegraLedger/integra-protocol.git",
    "directory": "packages/placements"
  },
  "bugs": {
    "url": "https://github.com/IntegraLedger/integra-protocol/issues"
  },
  "homepage": "https://github.com/IntegraLedger/integra-protocol/tree/main/packages/placements#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/sync-license.mjs"
  },
  "dependencies": {
    "@integraledger/lcp-binding-core": "workspace:*",
    "@integraledger/lcp-placement-a2a": "workspace:*",
    "@integraledger/lcp-placement-ack": "workspace:*",
    "@integraledger/lcp-placement-acp": "workspace:*",
    "@integraledger/lcp-placement-ap2": "workspace:*",
    "@integraledger/lcp-placement-mastercard-vi": "workspace:*",
    "@integraledger/lcp-placement-mpp": "workspace:*",
    "@integraledger/lcp-placement-ucp": "workspace:*",
    "@integraledger/lcp-placement-visa-tap": "workspace:*",
    "@integraledger/lcp-placement-x402": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  }
}
