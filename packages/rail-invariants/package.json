{
  "name": "@integraledger/lcp-rail-invariants",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Test-only. Cross-rail invariants that no single binding package can assert about itself — it imports EVERY binding so a new rail cannot quietly opt out. Never published.",
