    "@integraledger/lcp-binding-canton-x402": "workspace:*",
    "@integraledger/lcp-binding-cardano": "workspace:*",
    "@integraledger/lcp-binding-core": "workspace:*",
    "@integraledger/lcp-binding-evm-escrow": "workspace:*",
    "@integraledger/lcp-binding-evm-mpp": "workspace:*",
    "@integraledger/lcp-binding-evm-x402": "workspace:*",
    "@integraledger/lcp-binding-hedera": "workspace:*",
    "@integraledger/lcp-binding-solana": "workspace:*",
    "@integraledger/lcp-binding-stellar": "workspace:*",
    "@integraledger/lcp-binding-sui": "workspace:*",
    "@integraledger/lcp-binding-tempo-mpp": "workspace:*",
    "@integraledger/lcp-binding-xrpl": "workspace:*",
    "@integraledger/lcp-placement-x402": "workspace:*",
    "@types/node": "catalog:",
