{
  "name": "@integraledger/lcp-conformance",
  "version": "0.10.0",
  "description": "The LCP conformance corpus, its runner, and the adapters that drive an implementation under test.",
  "keywords": [
    "lcp",
    "legal-context-protocol",
    "legal-terms",
    "agentic-commerce",
    "conformance",
    "test-suite",
    "vectors"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "lcp-conformance": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "vectors",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IntegraLedger/integra-protocol.git",
    "directory": "packages/conformance"
  },
  "bugs": {
    "url": "https://github.com/IntegraLedger/integra-protocol/issues"
  },
  "homepage": "https://github.com/IntegraLedger/integra-protocol/tree/main/packages/conformance#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/pack-vectors.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/sync-license.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "catalog:",
    "@integraledger/lcp-authority": "workspace:*",
    "@integraledger/lcp-binding-core": "workspace:*",
    "@integraledger/lcp-discovery": "workspace:*",
    "@integraledger/lcp-evidence": "workspace:*",
    "@integraledger/lcp-kernel": "workspace:*",
    "@integraledger/lcp-placements": "workspace:*",
    "@integraledger/lcp-verify": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  }
}
