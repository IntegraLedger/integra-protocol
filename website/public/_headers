# Response headers for every file the site serves, as Cloudflare applies them to static assets
# (https://developers.cloudflare.com/workers/static-assets/headers/): every rule whose path matches a request applies,
# a header that two rules set takes both values joined by a comma, and the file holds at most 100 rules and no line
# over 2,000 characters (scripts/check-script-policy.mjs checks both limits).
#
# Everything a page loads comes from the site's own origin: scripts, styles, fonts, images, the search index and the
# Twoslash popups. No page loads a data: or blob: URL or starts a worker, so the policy names neither source. No page
# has a base element or a form, so neither is allowed, and no page is shown in a frame, on any origin
# (scripts/check-headers.mjs). The policy below allows inline scripts only so that each page's own policy can rule
# them: scripts/script-policy.mjs writes into every page a policy that allows the site's script files and the page's
# inline scripts by their SHA-256 hashes, and the browser enforces both, so an inline script runs only when the page
# hashes it. A header cannot hold those hashes, and one without 'unsafe-inline' refuses every inline script.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()

# Content-hashed build assets never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Extensionless files, and the Markdown copies of the pages.
/opengraph-image
  Content-Type: image/png
/api/search
  Content-Type: application/json; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/md/*
  Content-Type: text/markdown; charset=utf-8
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# Every file that is not a page takes a second policy, which loads nothing and runs no script: the browser enforces it
# beside the one above, so a file opened as a document, an SVG image above all, runs no script. These paths and file
# types hold every such file the build writes (scripts/check-script-policy.mjs checks each file of out/).
/_next/*
  Content-Security-Policy: default-src 'none'; script-src 'none'
/md/*
  Content-Security-Policy: default-src 'none'; script-src 'none'
/twoslash/*
  Content-Security-Policy: default-src 'none'; script-src 'none'
/api/*
  Content-Security-Policy: default-src 'none'; script-src 'none'
/ucp/*
  Content-Security-Policy: default-src 'none'; script-src 'none'
/a2a/*
  Content-Security-Policy: default-src 'none'; script-src 'none'
/.well-known/*
  Content-Security-Policy: default-src 'none'; script-src 'none'
/opengraph-image
  Content-Security-Policy: default-src 'none'; script-src 'none'
/*.txt
  Content-Security-Policy: default-src 'none'; script-src 'none'
/*.svg
  Content-Security-Policy: default-src 'none'; script-src 'none'
/*.xml
  Content-Security-Policy: default-src 'none'; script-src 'none'
/*.json
  Content-Security-Policy: default-src 'none'; script-src 'none'
/*.png
  Content-Security-Policy: default-src 'none'; script-src 'none'
