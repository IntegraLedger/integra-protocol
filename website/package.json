{
  "name": "integra-protocol-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26.11.1 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 __NEXT_AGENT_UPGRADE= next build && node scripts/lcp-documents.mjs && node scripts/script-policy.mjs && node scripts/worker-headers.mjs",
    "api": "typedoc --options typedoc.config.mjs",
    "browser": "node scripts/browser.mjs",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-twoslash": "4.0.2",
    "fumadocs-ui": "16.17.1",
    "mermaid": "12.2.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "hast-util-to-html": "9.0.5",
    "playwright-core": "1.64.0",
    "tailwindcss": "4.3.3",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "6.0.3"
  }
}
