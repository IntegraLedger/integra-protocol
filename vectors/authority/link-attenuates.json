        "parent": {
          "@context": ["https://www.w3.org/ns/credentials/v2"],
          "type": ["VerifiableCredential"],
          "issuer": "did:web:integraledger.com",
          "credentialSubject": {
            "id": "did:example:root",
            "bounds": {
              "caps": {
                "USD": "1000000"
              }
            },
            "delegable": true,
            "maxDepth": 1
          }
        }
      },
      "expected": false
    },
    {
      "name": "an omitted link depth below an UNBOUNDED parent attenuates — nothing was escalated",
      "input": {
        "link": {
          "@context": ["https://www.w3.org/ns/credentials/v2"],
