        "parent": {
          "@context": ["https://www.w3.org/ns/credentials/v2"],
          "type": ["VerifiableCredential"],
          "issuer": "did:web:integraledger.com",
          "credentialSubject": {
            "id": "did:example:root",
            "bounds": {
              "caps": {
                "USD": "1000000"
              }
            },
            "delegable": true,
            "maxDepth": 1
          }
        }
      },
      "expected": false
    },
    {
      "name": "a link that OMITS its depth below a depth-bounded parent is refused — absent is unbounded, not inherited",
      "input": {
        "link": {
