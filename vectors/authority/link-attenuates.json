    {
      "name": "a link claiming EXACTLY its parent's depth is refused — the ceiling is parentDepth - 1, not parentDepth",
      "input": {
        "link": {
          "@context": ["https://www.w3.org/ns/credentials/v2"],
          "type": ["VerifiableCredential"],
          "issuer": "did:web:integraledger.com",
