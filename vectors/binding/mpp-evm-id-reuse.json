        "code": "mpp-evm/candidate-malformed"
      }
    },
    {
      "name": "a short-hex candidate is malformed too — 32 bytes exactly, because the fixed length IS the anti-ambiguity argument",
      "input": {
        "op": "check",
        "atrHash": "0x7f83b165",
        "realm": "api.example.com",
        "observedNonces": [
          "0xb0e5403d5a7c3f550610af8a488db2d8aa1837fcf917fd6961cb5a5023b54f14"
        ]
      },
      "expected": {
        "refused": true,
        "haltClass": "verification-failure",
        "code": "mpp-evm/candidate-malformed"
      }
    },
    {
      "name": "a candidate with trailing bytes after the 32 is malformed — the value must END there",
      "input": {
        "op": "check",
        "atrHash": "0x7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069ff",
        "realm": "api.example.com",
        "observedNonces": [
          "0xb0e5403d5a7c3f550610af8a488db2d8aa1837fcf917fd6961cb5a5023b54f14"
        ]
      },
      "expected": {
        "refused": true,
        "haltClass": "verification-failure",
        "code": "mpp-evm/candidate-malformed"
      }
    },
    {
      "name": "a candidate with junk BEFORE the 0x is malformed — the value must START there",
      "input": {
        "op": "check",
        "atrHash": "lcp:0x7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069",
        "realm": "api.example.com",
        "observedNonces": [
          "0xb0e5403d5a7c3f550610af8a488db2d8aa1837fcf917fd6961cb5a5023b54f14"
        ]
      },
      "expected": {
        "refused": true,
        "haltClass": "verification-failure",
        "code": "mpp-evm/candidate-malformed"
      }
    },
    {
      "name": "a malformed observed nonce refuses LOUDLY rather than being skipped past",
