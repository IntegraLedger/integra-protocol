    {
      "name": "a malformed candidate refuses as DATA under audit — the auditor's input is never a crash",
      "input": {
        "op": "check",
        "atrHash": "nope",
        "realm": "api.example.com",
        "observedNonces": [
          "0xb0e5403d5a7c3f550610af8a488db2d8aa1837fcf917fd6961cb5a5023b54f14"
