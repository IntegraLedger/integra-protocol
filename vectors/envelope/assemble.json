{
  "cases": [
    {
      "name": "minimal record",
      "input": [
        {
          "slot": "terms",
          "value": "# Terms\nService provided as-is."
        },
        {
          "slot": "id",
          "value": "0x9f8b7a6c5d4e3f2a1b0c9d8e7f6a5b4c"
        }
      ],
      "expected": {
        "file": "{\"lcp\":\"0.3\",\"terms\":\"# Terms\\nService provided as-is.\",\"id\":\"0x9f8b7a6c5d4e3f2a1b0c9d8e7f6a5b4c\"}",
        "hash": "0xebbd7d8d17a7c988bee53682175446806f235f0d6c5ff054c39077d2e62d3df8"
      }
    },
    {
      "name": "duplicate slot",
      "input": [
        {
          "slot": "terms",
          "value": "a"
        },
        {
          "slot": "terms",
          "value": "b"
        },
        {
          "slot": "id",
          "value": "0x00"
        }
      ],
      "error": "assemble/duplicate-slot"
    },
    {
      "name": "integer-like slot",
      "input": [
        {
          "slot": "terms",
          "value": "a"
        },
        {
          "slot": "id",
          "value": "0x00"
        },
        {
          "slot": "1",
          "value": "x"
        }
      ],
      "error": "assemble/numeric-slot"
    },
    {
      "name": "escaping pin (the JSON.stringify wire contract)",
      "input": [
        {
          "slot": "terms",
          "value": "NFC:é nonBMP:😀 ctrl:\u0007 tab:\t quote:\" backslash:\\ loneSurrogate:\ud800"
        },
        {
          "slot": "id",
          "value": "0x01"
        }
      ],
      "expected": {
        "file": "{\"lcp\":\"0.3\",\"terms\":\"NFC:é nonBMP:😀 ctrl:\\u0007 tab:\\t quote:\\\" backslash:\\\\ loneSurrogate:\\ud800\",\"id\":\"0x01\"}",
        "hash": "0x12698cb24a1ab844d075dd09b986ee4e1b623ff9f34acb1e55e7f7e566302166"
      }
    },
    {
      "name": "__proto__ slot preserved as an own key (no silent drop)",
      "input": [
        {
          "slot": "terms",
          "value": "a"
        },
        {
          "slot": "id",
          "value": "0x00"
        },
        {
          "slot": "__proto__",
          "value": {
            "a": 1
          }
        }
      ],
      "expected": {
        "file": "{\"lcp\":\"0.3\",\"terms\":\"a\",\"id\":\"0x00\",\"__proto__\":{\"a\":1}}",
        "hash": "0x68b9e5b4cefba11f69be0744661800714b4a9ffb785d671b2448ec496478f5b0"
      }
    },
    {
      "name": "ref component placed at slot",
      "input": [
        {
          "slot": "terms",
          "value": "a"
        },
        {
          "slot": "id",
          "value": "0x00"
        },
        {
          "slot": "spendAuthority",
          "ref": "lcp:sha256:0x7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069"
        }
      ],
      "expected": {
        "file": "{\"lcp\":\"0.3\",\"terms\":\"a\",\"id\":\"0x00\",\"spendAuthority\":\"lcp:sha256:0x7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069\"}",
        "hash": "0xb1494ae1db38db44ac048673fc676df720c65f589467afa0b0b398b642cd6e4c"
      }
    },
