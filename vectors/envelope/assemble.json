    {
      "name": "caps raw number",
      "input": [
        {
          "slot": "terms",
          "value": "a"
        },
        {
          "slot": "id",
          "value": "0x00"
        },
        {
          "slot": "caps",
          "value": {
            "max": 9007199254740992
          }
        }
      ],
      "error": "assemble/caps-raw-number"
    },
    {
      "name": "caps nested raw number",
      "input": [
        {
          "slot": "terms",
          "value": "a"
        },
        {
          "slot": "id",
          "value": "0x00"
        },
        {
          "slot": "caps",
          "value": {
            "perAsset": {
              "usdc": 1e21
            }
          }
        }
      ],
      "error": "assemble/caps-raw-number"
    },
    {
      "name": "nested integer-like keys sort ahead of string keys, ascending",
      "input": [
        {
          "slot": "terms",
          "value": "a"
        },
        {
          "slot": "id",
          "value": "0x00"
        },
        {
          "slot": "meta",
          "value": {
            "2": "b",
            "1": "a",
            "10": "c"
          }
        }
      ],
      "expected": {
        "file": "{\"lcp\":\"0.3\",\"terms\":\"a\",\"id\":\"0x00\",\"meta\":{\"1\":\"a\",\"2\":\"b\",\"10\":\"c\"}}",
        "hash": "0x23c05ae8021d13454dbef3e5eb6626f3971a78cac96b5fd85c8743d471f430a9"
      }
    },
    {
      "name": "array-index boundary: 2^32-2 is an index, 2^32-1 is an ordinary key",
      "input": [
        {
          "slot": "terms",
          "value": "a"
        },
        {
          "slot": "id",
          "value": "0x00"
        },
        {
          "slot": "meta",
          "value": {
            "b": "x",
            "4294967295": "a",
            "4294967294": "z"
          }
        }
      ],
      "expected": {
        "file": "{\"lcp\":\"0.3\",\"terms\":\"a\",\"id\":\"0x00\",\"meta\":{\"4294967294\":\"z\",\"b\":\"x\",\"4294967295\":\"a\"}}",
        "hash": "0xc84417cc5e3397d0647b9d8de8727e6181e3861b6b740d8e0d4c164a16e369da"
      }
    },
    {
      "name": "integer-key ordering applies at depth, not only at the envelope top level",
      "input": [
        {
          "slot": "terms",
          "value": "a"
        },
        {
          "slot": "id",
          "value": "0x00"
        },
        {
          "slot": "meta",
          "value": {
            "inner": {
              "3": "c",
              "1": "a"
            },
            "z": "last"
          }
        }
      ],
      "expected": {
        "file": "{\"lcp\":\"0.3\",\"terms\":\"a\",\"id\":\"0x00\",\"meta\":{\"inner\":{\"1\":\"a\",\"3\":\"c\"},\"z\":\"last\"}}",
        "hash": "0x1b3b516260d740f50fa7e6b853085794cbf4db6ebf54088c38b3c16723946da1"
      }
    },
    {
      "name": "unpaired surrogate in a SLOT NAME (the escaping pin covers values only)",
      "input": [
        {
          "slot": "\ud800",
          "value": "x"
        },
        {
          "slot": "terms",
          "value": "a"
        },
        {
          "slot": "id",
          "value": "0x00"
        }
      ],
      "expected": {
        "file": "{\"lcp\":\"0.3\",\"\\ud800\":\"x\",\"terms\":\"a\",\"id\":\"0x00\"}",
        "hash": "0xfd961ce7f82f53620615298225dcd1f0d9dc6039dd8a54903cafd0407f17514d"
      }
    },
    {
      "name": "raw numbers outside caps: Number::toString incl. the 1e21 exponent threshold",
      "input": [
        {
          "slot": "terms",
          "value": "a"
        },
        {
          "slot": "id",
          "value": "0x00"
        },
        {
          "slot": "metrics",
          "value": {
            "half": 3.5,
            "exp": 1e21
          }
        }
      ],
      "expected": {
        "file": "{\"lcp\":\"0.3\",\"terms\":\"a\",\"id\":\"0x00\",\"metrics\":{\"half\":3.5,\"exp\":1e+21}}",
        "hash": "0xc6e1d4084743252cb5a88e67d5e33683aa9f2b2bceae70fd8c879b003a53ed3c"
      }
    }
  ]
