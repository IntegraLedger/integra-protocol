        {
          "slot": "terms",
          "value": "a"
        },
        {
          "slot": "id",
          "value": "0x00"
        },
        {
          "slot": "x",
          "value": "v",
          "ref": "lcp:sha256:0x7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069"
        }
      ],
      "error": "assemble/component-shape"
    },
