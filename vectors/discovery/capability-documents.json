{
  "cases": [
    {
      "name": "emit-a2a places the four AgentExtension proto fields in field order, required defaulting to false",
      "input": {
        "op": "emit-a2a",
        "declaration": {
          "minimumLevel": 2,
          "acceptedJurisdictions": ["New York, USA"],
          "acceptedDisputeMethods": ["Commercial Arbitration Rules"]
        }
      },
      "expected": {
        "uri": "https://integraledger.com/lcp/a2a/legal-context/v1",
        "required": false,
        "params": {
          "minimumLevel": 2,
          "acceptedJurisdictions": ["New York, USA"],
          "acceptedDisputeMethods": ["Commercial Arbitration Rules"]
        }
      }
    },
    {
      "name": "emit-a2a carries description — the fourth proto field LCP v1.37 §C.8 omits (Re-read against v1.38 on 2026-08-12: v1.38 §C.8 states `AgentExtension`’s four fields.)",
      "input": {
        "op": "emit-a2a",
        "declaration": {
          "minimumLevel": 2
        },
        "options": {
          "description": "Declines counterparties whose terms are not hash-verifiable."
        }
      },
      "expected": {
        "uri": "https://integraledger.com/lcp/a2a/legal-context/v1",
        "description": "Declines counterparties whose terms are not hash-verifiable.",
        "required": false,
        "params": {
          "minimumLevel": 2
        }
      }
    },
    {
      "name": "emit-a2a required true is an explicit deployment choice, never a default",
      "input": {
        "op": "emit-a2a",
        "declaration": {
          "minimumLevel": 3,
          "acceptedDisputeMethods": ["Commercial Arbitration Rules"]
        },
        "options": {
          "required": true
        }
      },
      "expected": {
        "uri": "https://integraledger.com/lcp/a2a/legal-context/v1",
        "required": true,
        "params": {
          "minimumLevel": 3,
          "acceptedDisputeMethods": ["Commercial Arbitration Rules"]
        }
      }
    },
    {
      "name": "emit-a2a canonicalizes params key order — level, jurisdictions, methods",
      "input": {
        "op": "emit-a2a",
        "declaration": {
          "acceptedDisputeMethods": ["Expedited Commercial Arbitration Rules"],
          "acceptedJurisdictions": ["California, USA"],
          "minimumLevel": 4
        }
      },
      "expected": {
        "uri": "https://integraledger.com/lcp/a2a/legal-context/v1",
        "required": false,
        "params": {
          "minimumLevel": 4,
          "acceptedJurisdictions": ["California, USA"],
          "acceptedDisputeMethods": ["Expedited Commercial Arbitration Rules"]
        }
      }
    },
    {
      "name": "emit-a2a level 1 alone is a complete declaration",
      "input": {
