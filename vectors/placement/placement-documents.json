    {
      "name": "a tagged-array container declares its tag and value fields, and field is the full locator",
      "$comment": "UCP's links and Mastercard VI's Layer-2 constraints reduce to the SAME rule with different data — an array of entries, find by a tag field's value, the reference in a value field. Two unrelated protocols sharing one rule is the evidence the abstraction is discovered rather than invented. `field` here is a human-readable LOCATOR; `container` carries the machine-readable form.",
      "input": {
        "protocol": "mastercard-vi",
        "pattern": "http-advisory",
        "tier": "A",
        "encoding": "bare-value",
        "container": {
          "kind": "tagged-array",
          "at": "constraints",
          "tagField": "type",
          "tag": "urn:example:lcp-terms-hash",
          "valueField": "value"
        },
        "field": "constraints[type=urn:example:lcp-terms-hash].value",
        "carrierTypes": ["sha256"]
      },
      "expected": true
    },
