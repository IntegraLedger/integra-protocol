            "path": "links[type=terms_of_service].url",
            "encoding": "bare-value",
            "bareType": "url",
            "carrierClass": "discovery",
            "write": true,
            "container": {
              "kind": "tagged-array",
              "at": "links",
              "tagField": "type",
              "tag": "terms_of_service",
              "valueField": "url"
            }
          }
        ],
        "carrierTypes": ["sha256"]
      },
      "expected": true
    },
