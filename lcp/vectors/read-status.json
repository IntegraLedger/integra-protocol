    "history": true
   },
   "query": {
    "finality": "final"
   },
   "expect": {
    "payment": {
     "state": "settled",
     "transaction": "t1",
     "finality": "final",
     "foreign": [],
     "moved": [
      {
       "asset": "A",
       "amount": "0",
       "to": "payee"
      }
     ]
    },
    "agreement": {
     "state": "settled",
     "transaction": "t1",
     "finality": "final",
     "foreign": [],
     "moved": [
      {
       "asset": "A",
       "amount": "0",
       "to": "payee"
      }
     ]
    }
   }
  },
