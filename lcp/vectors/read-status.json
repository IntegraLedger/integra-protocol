     {
      "transaction": "t1",
      "position": 10,
      "mark": "final",
      "result": "succeeded",
      "consumed": true,
      "carries": true,
      "party": "payer",
      "kind": "same",
      "account": "payee",
      "moved": [
       {
        "asset": "A",
        "amount": "0",
        "to": "payee"
       }
      ]
     }
    ],
    "search": {
     "whole": true
