 "pattern": {
  "pattern": "opaque-challenge",
  "canonical": true,
  "buyerSigns": false,
  "claims": true,
  "onChain": false,
  "zeroPartyRecoverable": false,
  "forwardIndexable": false,
  "publicProof": true,
  "proves": "The ATR's hash is in the MPP challenge this payment answered: its id is the hash in base64url with the challenge's position, protected by the server's binding of the challenge. The payer signed a Tempo transaction whose transferWithMemo call carries MPP's attribution memo, whose 7-byte nonce is keccak256 of that id. The chain verified the signature when it executed the call, and the memo is on chain as the memo topic of the token's TransferWithMemo event. It ties the payment to the challenge instance, and binds this ATR's hash only through those 7 bytes: whoever assembles the ATR can construct a second ATR whose challenge id gives the same 7 bytes. This does not show that amount, payee, asset or timing match the ATR's content."
 },
 "splits": {
  "about": "Tempo split payments, built by the buyer gate as several calls in one Tempo transaction. The splits and their amounts are the Tempo charge draft's own example (draft-tempo-charge-00 at 08e7dd87, L276-305); the rules are its L223-318: the primary recipient receives amount minus the sum of the splits (L233), each split with a memo uses transferWithMemo (L313-315), calls in array order (L273), and a client rejects a request whose splits sum to amount or more (L255-258). The calldata is hand-encoded: selector, the address left-padded to 32 bytes, the amount as a 32-byte word, then the memo.",
