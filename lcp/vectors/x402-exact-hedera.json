        "info": {
         "type": "sha256",
         "value": "0xba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
         "legalContextUrl": "https://atr.seller.example/7c8acfa2-f800-4192-89e9-1cef9833180f"
        },
        "schema": {
         "$schema": "https://json-schema.org/draft/2020-12/schema",
         "type": "object",
