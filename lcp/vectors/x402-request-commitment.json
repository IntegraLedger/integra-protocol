{
 "about": "Vectors for the request an x402 challenge commits to in the ATR's binding slot (x402-request-commitment.md). HTTP: the method as received, the target split at its first ?, SHA-256 over the body bytes. MCP: the tool's name and SHA-256 over the RFC 8785 form of its arguments, _meta not committed. The MCP calls are the x402 MCP transport's own example tools/call request (x402 d6d2c58, specs/transports-v2/mcp.md, Payment Payload Transmission) and the changes each row's case names. Expected values were computed with Python 3.12.3's hashlib.sha256 and, for RFC 8785, json.dumps(sort_keys=True, separators=(',',':'), ensure_ascii=False), which is RFC 8785's form for these values (keys of ASCII, numbers that are integers or 0.5); bodyUtf8 is the body's bytes as UTF-8.",
 "http": [
  {
   "case": "a POST with a query and a JSON body",
   "request": {
    "method": "POST",
    "target": "/v1/quote?tier=1&x=%41",
    "bodyUtf8": "{\"q\":\"latest market data\"}"
   },
   "expect": {
    "method": "POST",
    "path": "/v1/quote",
    "query": "tier=1&x=%41",
    "bodyDigest": "0x36ffcd607977d889a902212a5604d495d86f764d3ee58737db107359ea419bb7"
   }
  },
  {
   "case": "a GET with no query and an empty body",
   "request": {
    "method": "GET",
    "target": "/premium-data",
    "bodyUtf8": ""
   },
   "expect": {
    "method": "GET",
    "path": "/premium-data",
    "query": "",
    "bodyDigest": "0xe3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
   }
  },
  {
   "case": "a target whose query holds a second ?, split at the first",
   "request": {
    "method": "get",
    "target": "/a?b?c",
    "bodyUtf8": ""
   },
   "expect": {
    "method": "get",
    "path": "/a",
    "query": "b?c",
    "bodyDigest": "0xe3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
   }
  }
 ],
 "mcp": [
  {
   "case": "the MCP transport's example tool call, with its payment in _meta",
   "call": {
    "name": "financial_analysis",
    "arguments": {
     "ticker": "AAPL",
     "analysis_type": "deep"
    },
    "_meta": {
     "x402/payment": {
      "x402Version": 2,
      "resource": {
       "url": "mcp://tool/financial_analysis",
       "description": "Advanced financial analysis tool",
       "mimeType": "application/json"
      },
      "accepted": {
       "scheme": "exact",
       "network": "eip155:84532",
       "amount": "10000",
       "asset": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
       "payTo": "0x209693Bc6afc0C5328bA36FaF03C514EF312287C",
       "maxTimeoutSeconds": 60,
       "extra": {
        "name": "USDC",
        "version": "2"
       }
      },
      "payload": {
       "signature": "0x2d6a7588d6acca505cbf0d9a4a227e0c52c6c34008c8e8986a1283259764173608a2ce6496642e377d6da8dbbf5836e9bd15092f9ecab05ded3d6293af148b571c",
       "authorization": {
        "from": "0x857b06519E91e3A54538791bDbb0E22373e36b66",
        "to": "0x209693Bc6afc0C5328bA36FaF03C514EF312287C",
        "value": "10000",
        "validAfter": "1740672089",
        "validBefore": "1740672154",
        "nonce": "0xf3746613c2d920b5fdabc0856f2aeb2d4f88ee6037b8cc5d04a71a4462f13480"
       }
      }
     }
    }
   },
   "expect": {
    "tool": "financial_analysis",
    "argumentsDigest": "0x1c4c1db7a017ba868b3925690ca89ef5a814636daa960156f9de5c9d86590314"
   }
  },
  {
   "case": "the same call before payment, with no _meta",
   "call": {
    "name": "financial_analysis",
    "arguments": {
     "ticker": "AAPL",
     "analysis_type": "deep"
    }
   },
   "expect": {
    "tool": "financial_analysis",
    "argumentsDigest": "0x1c4c1db7a017ba868b3925690ca89ef5a814636daa960156f9de5c9d86590314"
   }
  },
  {
   "case": "the same call with another _meta member and its arguments in another order",
   "call": {
    "name": "financial_analysis",
    "arguments": {
     "analysis_type": "deep",
     "ticker": "AAPL"
    },
    "_meta": {
     "progressToken": 7
    }
   },
   "expect": {
    "tool": "financial_analysis",
    "argumentsDigest": "0x1c4c1db7a017ba868b3925690ca89ef5a814636daa960156f9de5c9d86590314"
   }
  },
  {
   "case": "one argument changed",
   "call": {
    "name": "financial_analysis",
    "arguments": {
     "ticker": "AAPL",
     "analysis_type": "quick"
    }
   },
   "expect": {
    "tool": "financial_analysis",
    "argumentsDigest": "0x20390d9e986a2dda515df3f1c300d4dd82e9f76c0a40a37af434f653a361dd4d"
   }
  },
  {
   "case": "no arguments, read as {}",
   "call": {
    "name": "get_weather"
   },
   "expect": {
    "tool": "get_weather",
    "argumentsDigest": "0x44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a"
   }
  },
  {
   "case": "arguments holding a number with a fraction and a non-ASCII string",
   "call": {
    "name": "convert",
    "arguments": {
     "amount": 0.5,
     "to": "€"
    }
   },
   "expect": {
    "tool": "convert",
    "argumentsDigest": "0xf6ee6c053bc5756bc6de06b14830af7d59f3bd0613bd5c5c34c5a1aecdc66ca6"
   }
  }
 ],
 "mcpRefusals": [
  {
   "case": "a name that is not a string",
   "call": {
    "name": 7
   },
   "expect": {
    "refused": true,
    "code": "x402/tool-call-malformed"
   }
  },
  {
   "case": "an empty name",
   "call": {
    "name": ""
   },
   "expect": {
    "refused": true,
    "code": "x402/tool-call-malformed"
   }
  },
  {
   "case": "a name of 8193 characters",
   "call": {
    "name": ""
   },
   "expect": {
    "refused": true,
    "code": "x402/tool-call-malformed"
   }
  },
  {
   "case": "arguments that are an array",
   "call": {
    "name": "t",
    "arguments": [
     1
    ]
   },
   "expect": {
    "refused": true,
    "code": "x402/tool-call-malformed"
   }
  },
  {
   "case": "arguments that are a string",
   "call": {
    "name": "t",
    "arguments": "{}"
   },
   "expect": {
    "refused": true,
    "code": "x402/tool-call-malformed"
   }
  },
  {
   "case": "arguments of more than 1 MiB in RFC 8785 form: {\"a\": a string of fill, fillLength times}",
   "call": {
    "name": "t"
   },
   "fill": "x",
   "fillLength": 1048576,
   "expect": {
    "refused": true,
    "code": "x402/request-too-large"
   }
  },
  {
   "case": "a call that is not an object",
   "call": "financial_analysis",
   "expect": {
    "refused": true,
    "code": "x402/tool-call-malformed"
   }
  }
 ]
}
