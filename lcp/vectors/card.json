 "agreedRefusals": {
  "about": "Refusal codes the specification leaves to the implementation, as this package applies them.",
  "rows": [
   {
    "case": "advertise with a link over 2048 characters",
    "expect": "card/legal-context-malformed"
   },
   {
    "case": "advertise or TAP build with a hash that is not 0x and 64 hex digits",
    "expect": "card/legal-context-malformed"
   },
   {
    "case": "read of shown JSON that is not an object, or has no legalContext member",
    "expect": "card/no-legal-context"
   },
   {
    "case": "read with a legalContext whose link is not https",
    "expect": "card/link-not-https"
   },
   {
    "case": "read with a legalContext whose link is over 2048 characters",
    "expect": "card/legal-context-malformed"
   },
   {
    "case": "VI read or build of a checkout_jwt that is not a string of three dot-separated visible-ASCII segments whose second decodes to a JSON object",
    "expect": "card/vi-malformed"
   },
   {
    "case": "VI read or build of a checkout_jwt over 16384 characters",
    "expect": "card/too-large"
   },
   {
    "case": "TAP bound with presented not an object, or signatureInput not a string",
    "expect": "card/tap-signature-input-malformed"
   },
   {
    "case": "TAP bound with signatureInput or signature over 8192 characters, a dictionary over 16 members, or an inner list over 32 items",
    "expect": "card/too-large"
   },
   {
    "case": "TAP bound with a Decimal, Date or Display String anywhere, or a Byte Sequence parameter, in signatureInput",
    "expect": "card/tap-signature-input-malformed"
   },
   {
    "case": "TAP bound with tag=agent-payer-auth as a Token rather than a String",
    "expect": "card/tap-no-payer-signature"
   },
   {
    "case": "TAP bound with lcpHash not an array, or a line that is not a string",
    "expect": "card/tap-field-malformed"
   },
   {
    "case": "TAP bound with the one lcp-hash line over 256 characters",
    "expect": "card/too-large"
   },
   {
    "case": "VI bound with a layer over 65536 characters or over 32 disclosures",
    "expect": "card/too-large"
   },
   {
    "case": "VI bound with an L2 or L3b layer that has no disclosure or a non-empty last part",
    "expect": "card/vi-malformed"
   },
   {
    "case": "VI bound with a layer payload lacking _sd_alg sha-256 or a delegate_payload array of {\"...\": string} entries",
