      },
      "accepts": [
       {
        "scheme": "exact",
        "network": "near:testnet",
        "amount": "1000000",
        "asset": "usdc.testnet",
        "payTo": "merchant.testnet",
        "maxTimeoutSeconds": 60
       }
      ],
      "extensions": {
