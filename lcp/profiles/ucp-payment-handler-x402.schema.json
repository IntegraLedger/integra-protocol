{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcp.integraledger.com/ucp/x402/2026-10-02/schema.json",
  "title": "com.integraledger.lcp.x402 payment handler",
  "description": "The x402 payment handler for UCP, com.integraledger.lcp.x402, version 2026-10-02: its configs, instrument and credential. Specification: https://lcp.integraledger.com/ucp/x402/2026-10-02",
  "name": "com.integraledger.lcp.x402",
  "version": "2026-10-02",
  "$defs": {
    "com.integraledger.lcp.x402": {
      "payment_instrument": {
        "title": "x402 instrument",
        "description": "Every instrument this handler accepts: one type, `x402`.",
        "$ref": "#/$defs/instrument"
      },
      "platform_schema": {
        "title": "com.integraledger.lcp.x402 (platform)",
        "description": "The handler in a platform's profile.",
        "allOf": [
          {
            "$ref": "https://ucp.dev/2026-08-25/schemas/payment_handler.json#/$defs/platform_schema"
          },
          {
            "type": "object",
            "properties": {
              "config": {
                "$ref": "#/$defs/platform_config"
              }
            }
          }
        ]
      },
      "business_schema": {
        "title": "com.integraledger.lcp.x402 (business)",
        "description": "The handler in the business's profile.",
        "allOf": [
          {
            "$ref": "https://ucp.dev/2026-08-25/schemas/payment_handler.json#/$defs/business_schema"
          },
          {
            "$ref": "#/$defs/business_handler"
          }
        ]
      },
      "response_schema": {
        "title": "com.integraledger.lcp.x402 (response)",
        "description": "The handler in a checkout response, authoritative for that checkout.",
        "allOf": [
          {
            "$ref": "https://ucp.dev/2026-08-25/schemas/payment_handler.json#/$defs/response_schema"
          },
          {
            "$ref": "#/$defs/response_handler"
          }
        ]
      }
    },
    "business_config": {
      "title": "Business config",
      "description": "`config` in the business's declaration, in its profile at `/.well-known/ucp`.",
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "enum": [
            "sandbox",
            "production"
          ]
        },
        "x402Version": {
          "type": "number",
          "const": 2
        },
        "network": {
          "type": "string",
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
          "description": "The rail's CAIP-2 network: every option the checkout offers is on it."
        },
        "asset": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string",
              "minLength": 1,
              "description": "The token's address on the network, as x402's `asset` writes it."
            },
            "symbol": {
              "type": "string",
              "minLength": 1,
              "examples": [
                "USDC"
              ]
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 36
            }
          },
          "required": [
            "address",
            "symbol",
            "decimals"
          ],
          "additionalProperties": false
        },
        "schemes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "exact",
              "auth-capture"
            ]
          }
        },
        "scale": {
          "type": "string",
          "minLength": 1,
          "description": "How a price in the checkout's currency is paid in the token, in words."
        },
        "disclosure": {
          "type": "object",
          "properties": {
            "presentation": {
              "type": "string",
              "const": "disclosure"
            },
            "content": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "presentation",
            "content"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "environment",
        "x402Version",
        "network",
        "asset",
        "schemes",
        "scale",
        "disclosure"
      ],
      "additionalProperties": false
    },
    "platform_config": {
      "title": "Platform config",
      "description": "`config` in a platform's declaration, in its profile.",
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "enum": [
            "sandbox",
            "production"
          ]
        },
        "x402Version": {
          "type": "number",
          "const": 2
        },
        "networks": {
          "description": "The networks the platform's wallet can pay on.",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
          }
        },
        "schemes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "exact",
              "auth-capture"
            ]
          }
        }
      },
      "additionalProperties": {}
    },
    "response_config": {
      "title": "Response config",
      "description": "`config` in a checkout response from `ready_for_complete`: the x402 `PaymentRequired` that carries H, the hash of the ATR, in `extensions.legalContext`, with the business config's `environment`, `network`, `scale` and `disclosure`.",
      "type": "object",
      "properties": {
        "x402Version": {
          "type": "number",
          "const": 2
        },
        "error": {
          "type": "string"
        },
        "resource": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "description": {
              "type": "string"
            },
            "mimeType": {
              "type": "string"
            },
            "serviceName": {
              "type": "string",
              "pattern": "^[ -~]{1,32}$"
            },
            "tags": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[ -~]{1,32}$"
              }
            },
            "iconUrl": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https?:\\/\\/"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": {}
        },
        "accepts": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scheme": {
                "type": "string",
                "enum": [
                  "exact",
                  "auth-capture"
                ]
              },
              "network": {
                "type": "string",
                "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
              },
              "amount": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,77})$"
              },
              "asset": {
                "type": "string",
                "minLength": 1
              },
              "payTo": {
                "type": "string",
                "minLength": 1
              },
              "maxTimeoutSeconds": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "extra": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/json_value"
                }
              }
            },
            "required": [
              "scheme",
              "network",
              "amount",
              "asset",
              "payTo",
              "maxTimeoutSeconds"
            ],
            "additionalProperties": {}
          }
        },
        "extensions": {
          "type": "object",
          "properties": {
            "legalContext": {
              "type": "object",
              "properties": {
                "info": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "sha256"
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^0x[0-9a-f]{64}$",
                      "description": "SHA-256 over the ATR's exact bytes: 0x and 64 lowercase hex."
                    },
                    "legalContextUrl": {
                      "type": "string",
                      "maxLength": 2048,
                      "pattern": "^https:\\/\\/[^\\s]+$"
                    }
                  },
                  "required": [
                    "type",
                    "value",
                    "legalContextUrl"
                  ],
                  "additionalProperties": {}
                },
                "schema": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/json_value"
                  }
                }
              },
              "required": [
                "info",
                "schema"
              ],
              "additionalProperties": {}
            }
          },
          "required": [
            "legalContext"
          ],
          "additionalProperties": {}
        },
        "environment": {
          "type": "string",
          "enum": [
            "sandbox",
            "production"
          ]
        },
        "network": {
          "type": "string",
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
        },
        "scale": {
          "type": "string",
          "minLength": 1
        },
        "disclosure": {
          "type": "object",
          "properties": {
            "presentation": {
              "type": "string",
              "const": "disclosure"
            },
            "content": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "presentation",
            "content"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "x402Version",
        "resource",
        "accepts",
        "extensions",
        "environment",
        "network",
        "scale",
        "disclosure"
      ],
      "additionalProperties": {}
    },
    "credential": {
      "title": "x402 credential",
      "description": "The buyer's signed x402 payment, whole, and the option it signed.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "x402"
        },
        "x402Version": {
          "type": "number",
          "const": 2
        },
        "paymentPayload": {
          "type": "object",
          "properties": {
            "x402Version": {
              "type": "number",
              "const": 2
            },
            "resource": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "description": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                },
                "serviceName": {
                  "type": "string",
                  "pattern": "^[ -~]{1,32}$"
                },
                "tags": {
                  "maxItems": 5,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[ -~]{1,32}$"
                  }
                },
                "iconUrl": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^https?:\\/\\/"
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": {}
            },
            "accepted": {
              "type": "object",
              "properties": {
                "scheme": {
                  "type": "string",
                  "minLength": 1
                },
                "network": {
                  "type": "string",
                  "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
                },
                "amount": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,77})$"
                },
                "asset": {
                  "type": "string",
                  "minLength": 1
                },
                "payTo": {
                  "type": "string",
                  "minLength": 1
                },
                "maxTimeoutSeconds": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "extra": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/json_value"
                  }
                }
              },
              "required": [
                "scheme",
                "network",
                "amount",
                "asset",
                "payTo",
                "maxTimeoutSeconds"
              ],
              "additionalProperties": {}
            },
            "payload": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/json_value"
              }
            },
            "extensions": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "info": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/json_value"
                    }
                  },
                  "schema": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/json_value"
                    }
                  }
                },
                "required": [
                  "info",
                  "schema"
                ],
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "x402Version",
            "accepted",
            "payload"
          ],
          "additionalProperties": {}
        },
        "paymentRequirements": {
          "type": "object",
          "properties": {
            "scheme": {
              "type": "string",
              "minLength": 1
            },
            "network": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
            },
            "amount": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,77})$"
            },
            "asset": {
              "type": "string",
              "minLength": 1
            },
            "payTo": {
              "type": "string",
              "minLength": 1
            },
            "maxTimeoutSeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "extra": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/json_value"
              }
            }
          },
          "required": [
            "scheme",
            "network",
            "amount",
            "asset",
            "payTo",
            "maxTimeoutSeconds"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "type",
        "x402Version",
        "paymentPayload",
        "paymentRequirements"
      ],
      "additionalProperties": {}
    },
    "instrument": {
      "title": "x402 instrument",
      "description": "The instrument a platform submits to complete the checkout.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "handler_id": {
          "type": "string",
          "description": "The `id` of the handler declaration it is paid through."
        },
        "type": {
          "type": "string",
          "const": "x402"
        },
        "billing_address": {
          "type": "object",
          "properties": {
            "extended_address": {
              "type": "string"
            },
            "street_address": {
              "type": "string"
            },
            "address_locality": {
              "type": "string"
            },
            "address_region": {
              "type": "string"
            },
            "address_country": {
              "type": "string"
            },
            "postal_code": {
              "type": "string"
            },
            "first_name": {
              "type": "string"
            },
            "last_name": {
              "type": "string"
            },
            "phone_number": {
              "type": "string"
            }
          },
          "additionalProperties": {}
        },
        "credential": {
          "$ref": "#/$defs/credential"
        },
        "display": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/json_value"
          }
        },
        "selected": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "handler_id",
        "type",
        "credential"
      ],
      "additionalProperties": {}
    },
    "business_handler": {
      "title": "Business declaration",
      "description": "The handler's declaration in the business's profile.",
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "spec": {
          "type": "string",
          "const": "https://lcp.integraledger.com/ucp/x402/2026-10-02"
        },
        "schema": {
          "type": "string",
          "const": "https://lcp.integraledger.com/ucp/x402/2026-10-02/schema.json"
        },
        "id": {
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/business_config"
        },
        "available_instruments": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "x402"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "version",
        "spec",
        "schema",
        "id",
        "config",
        "available_instruments"
      ],
      "additionalProperties": {}
    },
    "response_handler": {
      "title": "Response declaration",
      "description": "The handler's declaration in a checkout response: the business config before the checkout has an ATR, the response config from `ready_for_complete`.",
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "spec": {
          "type": "string",
          "format": "uri"
        },
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "id": {
          "type": "string"
        },
        "config": {
          "anyOf": [
            {
              "$ref": "#/$defs/response_config"
            },
            {
              "$ref": "#/$defs/business_config"
            }
          ]
        },
        "available_instruments": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "x402"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "version",
        "id",
        "config",
        "available_instruments"
      ],
      "additionalProperties": {}
    },
    "json_value": {
      "title": "Any JSON value",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json_value"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/json_value"
          }
        }
      ]
    }
  }
}
