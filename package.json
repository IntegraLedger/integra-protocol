{
  "name": "@integraledger/protocol-root",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "node scripts/check-dist-orphans.mjs --clean",
    "conformance": "node packages/conformance/dist/cli.js",
    "prepare": "node scripts/setup-hooks.mjs",
    "check:commit-trailers": "node scripts/check-commit-trailers.mjs",
    "check:dist": "node scripts/check-dist-orphans.mjs",
    "check:docblocks": "node scripts/check-docblocks.mjs",
    "check:doc-calls": "node scripts/check-doc-calls.mjs",
    "check:docs": "node scripts/check-doc-snippets.mjs",
    "check:harness-proof": "node scripts/check-harness-proof.mjs",
    "check:live-rails": "node scripts/live-rails.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "corpus:seal": "node scripts/corpus-seal.mjs",
    "depcruise": "node scripts/depcruise-gate.mjs",
    "docs:build": "npm --prefix website run build",
    "docs:dev": "npm --prefix website run dev",
    "drift": "pnpm --filter @integraledger/lcp-binding-evm-escrow drift",
    "spec-drift": "node scripts/spec-drift.mjs",
    "lint": "biome check .",
    "mutation": "node scripts/mutation.mjs",
    "release:approve": "node scripts/approve-staged.mjs",
    "test": "pnpm -r --workspace-concurrency=3 test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm check:versions && pnpm check:docblocks && pnpm check:live-rails && pnpm check:harness-proof && node scripts/corpus-seal.mjs --check && pnpm audit --audit-level moderate && pnpm -r build && pnpm check:dist && pnpm lint && pnpm depcruise && pnpm -r typecheck && pnpm check:docs && pnpm check:doc-calls && pnpm test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.10",
    "@changesets/cli": "3.0.1",
    "@integraledger/lcp-authority": "workspace:*",
    "@integraledger/lcp-binding-aptos": "workspace:*",
    "@integraledger/lcp-binding-canton": "workspace:*",
    "@integraledger/lcp-binding-canton-x402": "workspace:*",
    "@integraledger/lcp-binding-cardano": "workspace:*",
    "@integraledger/lcp-binding-core": "workspace:*",
    "@integraledger/lcp-binding-evm-common": "workspace:*",
    "@integraledger/lcp-binding-evm-escrow": "workspace:*",
    "@integraledger/lcp-binding-evm-mpp": "workspace:*",
    "@integraledger/lcp-binding-evm-x402": "workspace:*",
    "@integraledger/lcp-binding-hedera": "workspace:*",
    "@integraledger/lcp-binding-solana": "workspace:*",
    "@integraledger/lcp-binding-stellar": "workspace:*",
    "@integraledger/lcp-binding-sui": "workspace:*",
    "@integraledger/lcp-binding-tempo-mpp": "workspace:*",
    "@integraledger/lcp-binding-xrpl": "workspace:*",
    "@integraledger/lcp-conformance": "workspace:*",
    "@integraledger/lcp-discovery": "workspace:*",
    "@integraledger/lcp-evidence": "workspace:*",
    "@integraledger/lcp-kernel": "workspace:*",
    "@integraledger/lcp-placement-a2a": "workspace:*",
    "@integraledger/lcp-placement-ack": "workspace:*",
    "@integraledger/lcp-placement-acp": "workspace:*",
    "@integraledger/lcp-placement-ap2": "workspace:*",
    "@integraledger/lcp-placement-mastercard-vi": "workspace:*",
    "@integraledger/lcp-placement-mpp": "workspace:*",
    "@integraledger/lcp-placement-ucp": "workspace:*",
    "@integraledger/lcp-placement-visa-tap": "workspace:*",
    "@integraledger/lcp-placement-x402": "workspace:*",
    "@integraledger/lcp-placements": "workspace:*",
    "@integraledger/lcp-verify": "workspace:*",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@swc/core": "1.16.1",
    "@types/node": "catalog:",
    "dependency-cruiser": "18.2.0",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0"
}
